# Server-only (never commit real values; never prefix these with NEXT_PUBLIC_).
NEXT_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# These two MUST also be set in the deployed environment (e.g. Vercel) —
# a missing value silently skips the Google Sheets mirror sync.
GOOGLE_SHEETS_WEBHOOK_URL=
GOOGLE_SHEETS_WEBHOOK_SECRET=

# Public (inlined at build time). Safe to expose; the value ships in the client bundle.
# Production origin with no trailing slash, e.g. https://conference.example
NEXT_PUBLIC_SITE_URL=