# Server-only. Never prefix with NEXT_PUBLIC_. Never commit real values.
NEXT_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# These two MUST also be set in the deployed environment (e.g. Vercel) —
# a missing value silently skips the Google Sheets mirror sync.
